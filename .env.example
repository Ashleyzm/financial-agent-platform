APP_ENV=development
APP_NAME=Financial Multi-Agent Platform
APP_VERSION=0.1.0
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
POSTGRES_DB=financial_agents
POSTGRES_USER=financial_agents
POSTGRES_PASSWORD=change-me-in-local-env
DATABASE_URL=postgresql+psycopg://financial_agents:change-me-in-local-env@postgres:5432/financial_agents
CHECKPOINT_DATABASE_URL=postgresql://financial_agents:change-me-in-local-env@postgres:5432/financial_agents
LANGGRAPH_STRICT_MSGPACK=true
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
