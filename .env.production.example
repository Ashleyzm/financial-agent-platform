APP_ENV=production
APP_NAME=Financial Multi-Agent Platform
APP_VERSION=0.1.0
PUBLIC_PORT=80

POSTGRES_DB=financial_agents
POSTGRES_USER=financial_agents
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD

LANGGRAPH_STRICT_MSGPACK=true
LOG_LEVEL=INFO
MARKET_DATA_PROVIDER=mock

LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
